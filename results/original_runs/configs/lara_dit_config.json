{
  "mode": "lara_dit",
  "model": {
    "input_size": 32,
    "in_channels": 4,
    "patch_size": 4,
    "hidden_size": 768,
    "depth": 12,
    "num_heads": 12,
    "mlp_ratio": 4.0,
    "num_classes": 100,
    "class_dropout_prob": 0.1,
    "learn_sigma": false,
    "vae_model_id": "stabilityai/sd-vae-ft-ema"
  },
  "diffusion": {
    "num_timesteps": 1000,
    "schedule": "cosine",
    "cosine_s": 0.008,
    "cfg_scale": 1.5
  },
  "data": {
    "data_root": "/workspace/data/imagenet100",
    "cache_dir": "/workspace/cache",
    "image_size": 256,
    "num_workers": 8,
    "pin_memory": true,
    "persistent_workers": true,
    "prefetch_factor": 4,
    "augmentation_seed": 42
  },
  "train": {
    "batch_size": 128,
    "total_steps": 200000,
    "lr": 0.0001,
    "weight_decay": 0.0,
    "betas": [
      0.9,
      0.999
    ],
    "grad_clip": 1.0,
    "seed": 42,
    "use_amp": true,
    "amp_dtype": "bfloat16",
    "use_ema": true,
    "ema_decay": 0.9999,
    "ema_warmup_steps": 1000,
    "log_every": 100,
    "ckpt_every": 50000,
    "sample_every": 0,
    "output_dir": "/workspace/outputs"
  },
  "eval": {
    "num_samples": 10000,
    "batch_size": 64,
    "cfg_scale": 1.5,
    "sampling_steps": 1000,
    "is_splits": 10,
    "lpips_net": "alex",
    "hf_percentile": 75.0
  },
  "tiers": [
    {
      "name": "early",
      "blocks": [
        0,
        4
      ],
      "teacher": "dinov2",
      "gamma": 2.0,
      "lambda_0": 0.5
    },
    {
      "name": "mid",
      "blocks": [
        4,
        8
      ],
      "teacher": "clip",
      "gamma": 1.5,
      "lambda_0": 0.5
    },
    {
      "name": "deep",
      "blocks": [
        8,
        12
      ],
      "teacher": "mae",
      "gamma": 1.0,
      "lambda_0": 0.5
    }
  ],
  "run_name": "lara_dit"
}